# Copy to .env for local development. Never commit .env.
# Production values live in Railway variables (see docs/LAUNCH_CHECKLIST.md).

SECRET_KEY=change-me-to-a-long-random-string
FLASK_ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/magni
PUBLIC_BASE_URL=http://localhost:5000
ALLOWED_ORIGINS=http://localhost:5000

ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-haiku-5-5
# CLAUDE_FAST_MODEL=

ADMIN_USERNAME=admin
# Hash from: python scripts/hash_admin_password.py
ADMIN_PASSWORD=

# Email provider (Postmark, Resend, SendGrid...). Gmail is used if HOST is unset.
MAGNI_SMTP_FROM=
MAGNI_SMTP_PASSWORD=
